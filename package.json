{
  "name": "kosmos-marketing-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "node scripts/quality-check.mjs --lint",
    "format:check": "node scripts/quality-check.mjs --format",
    "test": "node scripts/site-smoke.mjs",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "check:config": "node scripts/site-smoke.mjs --config",
    "check:quick": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:config && node --test scripts/pnpm-migration.test.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@lucide/vue": "^1.16.0",
    "vue": "^3.6.0-beta.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "lefthook": "1.8.4",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  }
}
