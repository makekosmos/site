{
  "name": "kosmos-marketing-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "lint": "node scripts/quality-check.mjs --lint",
    "format:check": "node scripts/quality-check.mjs --format",
    "test": "node scripts/site-smoke.mjs",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "check:config": "node scripts/site-smoke.mjs --config",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build && bun run check:config",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@lucide/vue": "^1.16.0",
    "vue": "^3.6.0-beta.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "lefthook": "1.8.4",
    "typescript": "~5.8.3",
    "vite": "^5.4.0",
    "vue-tsc": "^2.1.0"
  }
}
